ANTHROPIC_API_KEY=your_claude_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3000
PUBLIC_BASE_URL=https://questforgeai.ai

# Required to use /app, /api/process, /api/status, and downloads.
# Leave unset in public deployments if you want processing fully disabled.
QUESTFORGE_OPERATOR_TOKEN=generate_a_long_random_operator_token

# Uploaded files and generated outputs older than this are deleted on startup
# and every 6 hours while the server is running.
QUESTFORGE_RETENTION_DAYS=30

# Paddle Billing (Merchant of Record)
# Use production values only after Paddle approves the account/domain and price IDs.
PADDLE_ENVIRONMENT=production
PADDLE_CLIENT_TOKEN=your_paddle_client_side_token
PADDLE_PRICE_STANDARD=pri_standard_1200
PADDLE_PRICE_LARGE=pri_large_1800
PADDLE_PRICE_MONTHLY=pri_monthly_4500
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_endpoint_secret
