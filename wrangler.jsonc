{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "questforge",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
